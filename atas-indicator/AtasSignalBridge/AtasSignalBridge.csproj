<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Must match the .NET runtime the ATAS install runs on: a library targeting a
      NEWER runtime than its host will not load.

      net10.0 is what ATAS ships on (Microsoft.WindowsDesktop.App 10.0.0, read
      from ATAS Platform\*.runtimeconfig.json). Confirm against your own install
      and override without editing this file if it differs:
          dotnet build -p:AtasTargetFramework=net8.0-windows
    -->
    <AtasTargetFramework Condition="'$(AtasTargetFramework)' == ''">net10.0-windows</AtasTargetFramework>
    <TargetFramework>$(AtasTargetFramework)</TargetFramework>

    <!-- Default install location. Override with -p:AtasPath=... if yours differs. -->
    <AtasPath Condition="'$(AtasPath)' == ''">C:\Program Files (x86)\ATAS Platform\</AtasPath>

    <RootNamespace>AtasSignalBridge</RootNamespace>
    <AssemblyName>AtasSignalBridge</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- ATAS.Indicators is a WPF assembly, so the referencing project needs WPF too. -->
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    The ATAS SDK is not published on NuGet; it is referenced straight out of the
    installed platform directory. This is why the project only builds on a
    Windows machine with ATAS installed.
  -->
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasPath)ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(AtasPath)ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>$(AtasPath)OFT.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(AtasPath)Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
