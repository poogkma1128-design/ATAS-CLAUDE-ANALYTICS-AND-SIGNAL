<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Must match the .NET runtime the ATAS install runs on: a library targeting a
      NEWER runtime than its host will not load.

      net10.0 is what ATAS ships on (Microsoft.WindowsDesktop.App 10.0.0, read
      from ATAS Platform\*.runtimeconfig.json). Confirm against your own install
      and override without editing this file if it differs:
          dotnet build -p:AtasTargetFramework=net8.0-windows
    -->
    <AtasTargetFramework Condition="'$(AtasTargetFramework)' == ''">net10.0-windows</AtasTargetFramework>
    <TargetFramework>$(AtasTargetFramework)</TargetFramework>

    <!-- Default install location. Override with -p:AtasPath=... if yours differs. -->
    <AtasPath Condition="'$(AtasPath)' == ''">C:\Program Files (x86)\ATAS Platform\</AtasPath>

    <!--
      The indicator's REV. Its own number, deliberately not shared with the
      dashboard: the indicator has changed 6 times in 52 commits while the web
      and server have changed 25 between them, so one number across both would
      move this one on every server deploy and send someone to rebuild a DLL
      that did not change. The same misreading in section 3.8 of HANDOFF already
      cost a debugging session.

      `deno task rev:check` fails when this directory has changed since this
      number last moved, so it cannot quietly go stale the way it did between
      1.1.0 and here.

      MAJOR: the ingest contract changes. MINOR: something new the owner sees.
      PATCH: fixes and wording.
    -->
    <Version>1.3.1</Version>

    <RootNamespace>AtasSignalBridge</RootNamespace>
    <AssemblyName>AtasSignalBridge</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- ATAS.Indicators is a WPF assembly, so the referencing project needs WPF too. -->
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    The ATAS SDK is not published on NuGet; it is referenced straight out of the
    installed platform directory. This is why the project only builds on a
    Windows machine with ATAS installed.
  -->
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasPath)ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(AtasPath)ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>$(AtasPath)OFT.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(AtasPath)Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Stamps the build into a generated constant.

    ATAS shows a class-level [Description] in the About panel, and an attribute
    argument has to be a compile-time constant, so the version cannot simply be
    read off the assembly at runtime: it has to exist as a const before the
    compiler runs.

    A hand-maintained constant would be worse than nothing here, because the
    one question it exists to answer is whether the loaded DLL is the current
    one, and a stale string answers it wrongly.
  -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile">

    <!--
      The last commit that touched THIS directory, not the repository's HEAD.
      Most work in this repo is server-side, so HEAD moves constantly while the
      indicator does not. Stamping HEAD made a perfectly current DLL report a
      commit that no longer matched the repo and read as stale: the About tab
      said a9d3da6 while main had moved on, even though no commit in between
      had touched a single C# file. Stamping the indicator's own last change
      means this string moves only when the thing it describes moves.
    -->
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; log -1 --abbrev=7 --format=%h -- ."
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShaRaw" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>

    <PropertyGroup>
      <!-- Built from a zip, or without git installed: say so rather than lie. -->
      <_Commit Condition="'$(_GitExitCode)' != '0' or '$(_GitShaRaw)' == ''">no-git</_Commit>
      <_Commit Condition="'$(_Commit)' == ''">$(_GitShaRaw.Trim())</_Commit>
      <_BuiltAt>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))</_BuiltAt>
      <_BuildInfoPath>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoPath>
    </PropertyGroup>

    <!--
      Semicolons separate items, so every one in the generated C# is escaped as
      %3B. The content stays ASCII: WriteLinesToFile emits no BOM, and the
      compiler would misread anything else.
    -->
    <ItemGroup>
      <_BuildInfoLines Include="// Generated by the GenerateBuildInfo target. Do not edit, do not commit." />
      <_BuildInfoLines Include="namespace AtasSignalBridge" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    internal static class BuildInfo" />
      <_BuildInfoLines Include="    {" />
      <_BuildInfoLines Include="        public const string Version = &quot;$(Version)&quot;%3B" />
      <_BuildInfoLines Include="        public const string Commit = &quot;$(_Commit)&quot;%3B" />
      <_BuildInfoLines Include="        public const string BuiltAt = &quot;$(_BuiltAt)&quot;%3B" />
      <_BuildInfoLines Include="        public const string Summary =" />
      <_BuildInfoLines Include="            &quot;REV $(Version) | commit $(_Commit) | built $(_BuiltAt)&quot;%3B" />
      <_BuildInfoLines Include="    }" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_BuildInfoPath)"
                      Lines="@(_BuildInfoLines)"
                      Overwrite="true"
                      Encoding="ASCII" />

    <ItemGroup>
      <Compile Include="$(_BuildInfoPath)" />
    </ItemGroup>
  </Target>

</Project>
